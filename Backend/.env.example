# Copy this file to .env and fill in your real values.
# Never commit .env — only commit this file.

PORT=8000
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Supabase
SUPABASE_DATABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI providers
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-105b
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite-preview-06-17
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# Email Notification Service (Gmail SMTP via Nodemailer)
GMAIL_USER=gobeyondthelimits.ai@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
EMAIL_FROM=gobeyondthelimits.ai@gmail.com

# Feature flags
LLM_PROVIDER=auto
TTS_PROVIDER=sarvam
STT_PROVIDER=sarvam-streaming
ENABLE_RAG=true
RAG_TIMEOUT_MS=2000

# Google OAuth & Google Meet API (TherapyXAI Central Account)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=your_therapyxai_google_refresh_token_here

# Post-session disorder analysis (HuggingFace Space). Off unless ANALYSIS_ENABLED=true.
# Set HF_API_KEY in your shell / Railway dashboard -- do NOT put the real value in .env.
ANALYSIS_ENABLED=false
# Show analysis "themes" to signed-in users on the session detail page. Off by default.
# Turn on only after you've reviewed the wording and the support-resources list in the frontend.
INSIGHTS_ENABLED=false
# Store guest (not signed-in) chats in the separate guest_chat_messages table. Off by default.
# Needs consent copy + a retention plan first (see db/guest_chat_messages_migration.sql).
STORE_GUEST_CHATS=false
HF_ANALYZE_URL=https://your-username-your-space.hf.space/analyze-session
HF_API_KEY=your_hf_space_api_key_here

# Guests get reflections after signing in with consent (transcript held in memory only)
GUEST_REFLECTIONS_ENABLED=false
GUEST_REFLECTION_WINDOW_MIN=20
